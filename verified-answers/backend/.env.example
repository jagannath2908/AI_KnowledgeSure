# Application
PROJECT_NAME="Verified Answers"
ENVIRONMENT="development"
DEBUG=true

# Database
# Option 1: SQLite for instant zero-configuration local dev and testing
DATABASE_URL=sqlite:///./verified_answers.db

# Option 2: Production PostgreSQL with pgvector
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verified_answers

# Security
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-string-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider: OpenAI (Reasoning, Grounded Answering, Multi-hop Synthesis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini

# AI Provider: NVIDIA / Llama (Semantic Embeddings & Retrieval)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AI Provider: Google Gemini (Fallback / Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=25

# RAG Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.65
TOP_K_SOURCES=5
